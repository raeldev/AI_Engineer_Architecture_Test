# Copie este arquivo para .env e preencha com sua chave.
# Obtenha uma chave em https://aistudio.google.com/apikey (uso gratuito para teste).
GOOGLE_API_KEY=

# Se preferir usar Vertex AI em vez da API pública do Gemini, descomente e
# configure estas três variáveis em vez da chave acima:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
# GOOGLE_CLOUD_LOCATION=us-central1
